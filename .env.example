# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# AI provider: "gemini" (default) or "huggingface".
AI_PROVIDER="gemini"

# Required when AI_PROVIDER=gemini. Also used by the /api/refresh AI fallback.
GEMINI_API_KEY=""

# Required when AI_PROVIDER=huggingface. Also used by the /api/refresh AI fallback.
HF_TOKEN=""

# Optional: SerpAPI key for real Amazon India price refreshes.
# Without it, /api/refresh generates listings with AI.
SERP_API_KEY=""

# Optional: Supabase overrides. Without them the app uses the local fallback catalog.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Server port (default: 3000).
PORT=""
