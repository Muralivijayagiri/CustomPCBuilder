# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Required for AI chat and the /api/refresh Gemini fallback.
GEMINI_API_KEY=""

# Optional: SerpAPI key for real Amazon India price refreshes.
# Without it, /api/refresh generates listings with Gemini.
SERP_API_KEY=""

# Optional: Hugging Face token. The AI provider is currently hardcoded to Gemini.
HF_TOKEN=""

# Optional: Supabase overrides. server/config/env.ts has working fallbacks.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Server port (default: 3000).
PORT=""

# Read by server/config/env.ts but unused; the server listens on PORT.
BACKEND_PORT=""

# Not read by the app (AI Studio metadata).
APP_URL=""
